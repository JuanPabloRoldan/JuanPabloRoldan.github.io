@mastersthesis{roldan2026thesis,
  author  = {Roldan, Juan P.},
  title   = {Numerical Investigation of Shock-Induced Deformation of Bubble-Laden Droplets},
  school  = {Embry-Riddle Aeronautical University},
  year    = {2026},
  month   = {8},
  type    = {Master's Thesis},
  url     = {https://commons.erau.edu/edt/1019},
  abstract = {Rain impact can be a source of surface erosion on hypersonic vehicles, and the severity of each impact depends on droplet velocity, mass, and final shape, all of which are set by how the droplet breaks up under shock loading. This work investigates whether the mechanical, pressure-driven response of entrained non-condensable gas nuclei, independent of vaporization, is large enough to measurably alter the internal pressure field and early deformation of a shock-loaded droplet. A compressible, diffuse-interface, axisymmetric Eulerian framework in MFC is coupled two-way to sub-grid Lagrangian bubbles governed by the Keller-Miksis equation. Across 36 gas-seeded cases spanning shock Mach number, nucleus radius, and population size, bubble-induced pressure perturbations produce no measurable change in early-time droplet deformation, indicating that bulk deformation is governed by external aerodynamic loading and that the clean-droplet approximation remains adequate even with substantial nuclei populations.}
}

